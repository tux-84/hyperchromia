# Build-time defaults for HyperChromia. Copy/edit as needed before running build.sh.

# Hostname baked into a fresh image (persists across reboots once changed via
# `hy netconfig`, through the /etc overlay onto the DATA partition).
HYPERCHROMIA_DEFAULT_HOSTNAME=hyperchromia

# HyperHDR version tag baked in as the initial installed version. "latest"
# auto-detects the newest release from
# https://github.com/awawa-dev/HyperHDR/releases at build time. Set to a
# specific tag (e.g. v22.0.0.0) only to pin a version.
HYPERHDR_DEFAULT_VERSION=latest
